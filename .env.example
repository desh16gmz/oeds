# Copy this file to ".env" and fill it in.  (start.bat / start.sh do the copy for you)

# REQUIRED — bot token: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# OPTIONAL — your server ID(s). With this set, slash commands appear instantly (only in those servers).
# Several servers: separate with commas.  Leave EMPTY to run the bot in many servers (global commands, ~1h delay the first time).
GUILD_ID=

# OPTIONAL — custom "Watching ..." status text. Leave empty for the rotating default.
BOT_STATUS=

# OPTIONAL — where the data file lives (default: ./data)
# DATA_DIR=./data
